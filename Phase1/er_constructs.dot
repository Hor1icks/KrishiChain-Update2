/* KrishiChain -- Detail views of the five graded ER constructs.
   Full Chen notation with attributes. This is the sheet the examiner reads.
   Notation:  __underline__ = key    (partial) = partial key of weak entity
              double ellipse = multivalued     dashed ellipse = derived
              double box = weak entity         double diamond = identifying
              double line = total participation */

digraph Constructs {
  compound=true;
  rankdir=TB;
  splines=polyline;
  nodesep=0.30;
  ranksep=0.45;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, arrowhead=none, color="#44524a"];

  /* =============== 1. SPECIALIZATION =============== */
  subgraph cluster_spec {
    label="1. SPECIALIZATION  --  disjoint (d), total participation";
    fontsize=12; fontcolor="#14532D"; color="#14532D"; penwidth=1.6;
    style=rounded; margin=14;

    s_users [shape=box, style="filled,bold", fillcolor="#DCEFDC",
             color="#14532D", penwidth=1.4, label="USERS"];

    /* attributes of the superclass */
    node [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B", fontsize=8];
      a_uid   [label="UserID (PK)", fontname="Helvetica-Bold"];
      a_email [label="Email"];
      a_role  [label="Role\n(discriminator)"];
    node [peripheries=2];
      a_phone [label="PhoneNo\n(multivalued)"];
    node [peripheries=1, style="filled,dashed"];
      a_age   [label="Age (derived)"];
    node [style=filled];
      a_name  [label="Name (composite)"];
      a_fn [label="First"]; a_mn [label="Middle"]; a_ln [label="Last"];

    a_uid -> s_users; a_email -> s_users; a_role -> s_users;
    a_phone -> s_users; a_age -> s_users; a_name -> s_users;
    a_fn -> a_name; a_mn -> a_name; a_ln -> a_name;

    s_isa [shape=circle, style=filled, fillcolor="#F3E8FF", color="#6B21A8",
           width=0.36, fixedsize=true, label="d", fontsize=12];
    s_users -> s_isa [penwidth=2.8, label="total"];

    node [shape=box, style="filled,bold", fillcolor="#DCEFDC",
          color="#14532D", penwidth=1.4, fontsize=9, peripheries=1];
      s_far [label="FARMER\nNID, BankAccountNo\nExperienceYears"];
      s_buy [label="BUYER\nBusinessName\nTradeLicenseNo"];
      s_adm [label="ADMIN\nEmployeeID\nDesignation"];
      s_stm [label="STORAGE_MANAGER\nEmployeeID"];
      s_trp [label="TRANSPORT_PERSONNEL\nLicenseNo"];

    s_isa -> s_far; s_isa -> s_buy; s_isa -> s_adm;
    s_isa -> s_stm; s_isa -> s_trp;
  }

  /* =============== 2. AGGREGATION =============== */
  subgraph cluster_agg {
    label="2. AGGREGATION  --  the bidding relationship itself creates the sale order";
    fontsize=12; fontcolor="#6B21A8"; color="#6B21A8"; penwidth=1.6;
    style=rounded; margin=14;

    subgraph cluster_inner {
      label="aggregated relationship set";
      fontsize=9; fontcolor="#6B21A8"; color="#6B21A8";
      style="dashed,rounded"; penwidth=1.8;

      g_buyer [shape=box, style="filled,bold", fillcolor="#DCEFDC",
               color="#14532D", penwidth=1.4, label="BUYER"];
      g_place [shape=diamond, style=filled, fillcolor="#FFFFFF",
               color="#2E7D32", label="places", width=1.0, height=0.42];
      g_bid   [shape=box, style="filled,bold", fillcolor="#DCEFDC",
               color="#14532D", penwidth=1.4,
               label="BID\nBidID (PK)\nBidPricePerKg\nRequestedQuantity\nBidTime, Status"];
      g_on    [shape=diamond, style=filled, fillcolor="#FFFFFF",
               color="#2E7D32", label="on", width=1.0, height=0.42];
      g_batch [shape=box, style="filled,bold", fillcolor="#DCEFDC",
               color="#14532D", penwidth=1.4,
               label="HARVEST_BATCH\nBatchID (PK)\nMinimumPrice\nBiddingEndTime"];

      g_buyer -> g_place [label="1"];
      g_place -> g_bid   [label="N"];
      g_batch -> g_on    [label="1", penwidth=2.6];
      g_on    -> g_bid   [label="N"];
    }

    g_creates [shape=diamond, style=filled, fillcolor="#F3E8FF",
               color="#6B21A8", penwidth=1.6, label="creates", width=1.1, height=0.45];
    g_order [shape=box, style="filled,bold", fillcolor="#DCEFDC",
             color="#14532D", penwidth=1.4,
             label="SALE_ORDER\nSaleOrderID (PK)\nAcceptedQuantity\nAcceptedPricePerKg"];
    g_total [shape=ellipse, style="filled,dashed", fillcolor="#FFFFFF",
             color="#5B6B5B", fontsize=8, label="TotalAmount\n(derived)"];

    g_bid -> g_creates [ltail=cluster_inner, style=dashed, color="#6B21A8",
                        penwidth=1.6, label="1"];
    g_creates -> g_order [label="1"];
    g_total -> g_order;
  }

  /* =============== 3. TERNARY =============== */
  subgraph cluster_tern {
    label="3. TERNARY RELATIONSHIPS  --  two of them";
    fontsize=12; fontcolor="#1D4E89"; color="#1D4E89"; penwidth=1.6;
    style=rounded; margin=14;

    /* T-1 STORES */
    t1_b [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="HARVEST_BATCH"];
    t1_u [shape=box, peripheries=2, style="filled,bold", fillcolor="#FBE9C7",
          color="#B45309", penwidth=1.4, label="STORAGE_UNIT\n(weak)"];
    t1_m [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="STORAGE_MANAGER"];
    t1_d [shape=diamond, style=filled, fillcolor="#E3F0FB", color="#1D4E89",
          penwidth=1.6, label="STORES", width=1.25, height=0.5];

    t1_b -> t1_d [label="M"];
    t1_u -> t1_d [label="N"];
    t1_m -> t1_d [label="P"];

    node [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B",
          fontsize=8, peripheries=1];
      t1_q  [label="QuantityStored"];
      t1_in [label="DateIn"];
      t1_out[label="DateOut"];
    t1_q -> t1_d; t1_in -> t1_d; t1_out -> t1_d;

    /* T-2 ASSIGNED_TO */
    t2_r [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="TRANSPORT_REQUEST"];
    t2_v [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="VEHICLE"];
    t2_p [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="TRANSPORT_PERSONNEL"];
    t2_d [shape=diamond, style=filled, fillcolor="#E3F0FB", color="#1D4E89",
          penwidth=1.6, label="ASSIGNED_TO", width=1.35, height=0.5];

    t2_r -> t2_d [label="M"];
    t2_v -> t2_d [label="N"];
    t2_p -> t2_d [label="P"];

    node [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B", fontsize=8];
      t2_dt [label="AssignedDate"];
      t2_st [label="AssignmentStatus"];
    t2_dt -> t2_d; t2_st -> t2_d;
  }

  /* =============== 4. WEAK ENTITIES =============== */
  subgraph cluster_weak {
    label="4. WEAK ENTITIES  --  double box, double diamond, double line, dashed-underlined partial key";
    fontsize=12; fontcolor="#B45309"; color="#B45309"; penwidth=1.6;
    style=rounded; margin=14;

    /* W-1 */
    w1_o [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="WAREHOUSE\nWarehouseID (PK)\nCapacity"];
    w1_d [shape=diamond, peripheries=2, style=filled, fillcolor="#FBE9C7",
          color="#B45309", penwidth=1.5, label="contains", width=1.1, height=0.45];
    w1_w [shape=box, peripheries=2, style="filled,bold", fillcolor="#FBE9C7",
          color="#B45309", penwidth=1.5, label="STORAGE_UNIT"];
    w1_k [shape=ellipse, style=filled, fillcolor="#FFF8EC", color="#B45309",
          fontsize=8, label="UnitNo\n(partial key)"];
    w1_c [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B",
          fontsize=8, label="Capacity"];
    w1_l [shape=ellipse, style="filled,dashed", fillcolor="#FFFFFF",
          color="#5B6B5B", fontsize=8, label="CurrentLoad\n(derived)"];

    w1_o -> w1_d [label="1", penwidth=2.8];
    w1_d -> w1_w [label="N", penwidth=2.8];
    w1_k -> w1_w; w1_c -> w1_w; w1_l -> w1_w;

    /* W-2 */
    w2_o [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="PHYSICAL_BAZAR\nBazarID (PK)\nBazarName"];
    w2_d [shape=diamond, peripheries=2, style=filled, fillcolor="#FBE9C7",
          color="#B45309", penwidth=1.5, label="records", width=1.1, height=0.45];
    w2_w [shape=box, peripheries=2, style="filled,bold", fillcolor="#FBE9C7",
          color="#B45309", penwidth=1.5, label="BAZAR_DAILY_RECORD"];
    w2_k [shape=ellipse, style=filled, fillcolor="#FFF8EC", color="#B45309",
          fontsize=8, label="RecordDate\n(partial key)"];
    w2_v [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B",
          fontsize=8, label="TransactionVolume"];
    w2_r [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#5B6B5B",
          fontsize=8, label="Revenue"];

    w2_o -> w2_d [label="1", penwidth=2.8];
    w2_d -> w2_w [label="N", penwidth=2.8];
    w2_k -> w2_w; w2_v -> w2_w; w2_r -> w2_w;
  }

  /* =============== 5. RECURSIVE =============== */
  subgraph cluster_rec {
    label="5. RECURSIVE RELATIONSHIPS (self-joins)  --  role names required on both edges";
    fontsize=12; fontcolor="#7A5210"; color="#7A5210"; penwidth=1.6;
    style=rounded; margin=14;

    r1_e [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="VIRTUAL_ARAT\nAratID (PK)\nAratName, Region"];
    r1_d [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#2E7D32",
          label="supervises", width=1.2, height=0.45];
    r1_e -> r1_d [label="  1   role: parent ARAT"];
    r1_d -> r1_e [label="  N   role: child ARAT"];

    r2_e [shape=box, style="filled,bold", fillcolor="#DCEFDC", color="#14532D",
          penwidth=1.4, label="BID\nBidID (PK)\nBidPricePerKg"];
    r2_d [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#2E7D32",
          label="outbids", width=1.2, height=0.45];
    r2_e -> r2_d [label="  1   role: new bid"];
    r2_d -> r2_e [label="  1   role: displaced bid"];
  }

  /* force the five clusters to stack vertically instead of side by side */
  s_far -> g_buyer [style=invis, weight=100];
  g_order -> t1_b  [style=invis, weight=100];
  t2_d -> w1_o     [style=invis, weight=100];
  w2_w -> r1_e     [style=invis, weight=100];
}
