# Copy this file to `.env` and edit for your machine.
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------
# Oracle Instant Client 19c — the unzipped directory.
# node-oracledb MUST run in Thick mode: its default Thin mode requires
# Oracle Database 12.1+ and cannot connect to XE 11.2 at all.
# This must be the same bitness as your XE install AND your Node.js,
# or you get a misleading DPI-1047 error.
# Do NOT point this at a OneDrive-synced folder.
# ---------------------------------------------------------------------
ORACLE_CLIENT_DIR=C:\oracle\instantclient_19_26

# ---------------------------------------------------------------------
# Database. XE's SID is fixed as XE. Never use SYS/SYSTEM here.
# ---------------------------------------------------------------------
DB_USER=krishichain
# QUOTE the password. An unquoted `#` starts a comment in a .env file, so
# DB_PASSWORD=Krishi#2026 silently becomes "Krishi" and you get
# ORA-01017: invalid username/password.
DB_PASSWORD="Krishi#2026"
DB_CONNECT_STRING=localhost:1521/XE
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------
# API. Port 8080 is taken by XE's bundled APEX — do not use it.
# ---------------------------------------------------------------------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Change this to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------
# SSLCommerz. Leave blank and the card option is hidden; the rest of the
# app works unchanged. Sandbox credentials come from registering a store
# at https://developer.sslcommerz.com/ — the sandbox issues a test store
# ID and password immediately.
#
# The gateway redirects the browser back to this server, so localhost is
# fine and no tunnel is needed. Their server-to-server IPN cannot reach
# localhost, which is why settlement is confirmed by calling their
# validation API on the redirect rather than waiting for an IPN.
# ---------------------------------------------------------------------
# Sandbox store credentials from https://developer.sslcommerz.com/.
# The sandbox password is the store ID with @ssl on the end.
# SSLCommerz's own public store (testbox / qwerty) also works if you have
# not registered one yet.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
